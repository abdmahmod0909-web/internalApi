# =============================================================================
# InternalAPI - Server & Cloud Deployment Configuration
# =============================================================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database Configuration (Host Database)
# -----------------------------------------------------------------------------
# You can provide a full DATABASE_URL or configure individual DB_* parameters.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/internalapi?schema=public"

# Granular Database Connection (Optional if DATABASE_URL is set):
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=internalapi
DB_SSL=false

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# Master 32-character key for AES-256-GCM encrypted environment variables
INTERNALAPI_SECRET_KEY="internalapi-super-secure-master-encryption-key-32chars"

# Secret key used to sign and verify user JWT sessions
JWT_SECRET="internalapi-jwt-secret-key-change-this-in-production-random-64-chars"
JWT_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Default Initial Administrator Account
# -----------------------------------------------------------------------------
# Seeded automatically on first server boot if no users exist.
# Login with this email and password, then create accounts for your team!
ADMIN_EMAIL="admin@internalapi.local"
ADMIN_PASSWORD="admin123456"
ADMIN_NAME="InternalAPI Admin"

# -----------------------------------------------------------------------------
# CORS & Networking
# -----------------------------------------------------------------------------
# Allowed origins for desktop and web clients (use * for all, or comma-separated domains)
CORS_ORIGIN="*"

# SSRF Protection
# Set true to allow requests to internal private subnets (10.x, 192.168.x, 172.x)
# Cloud metadata (169.254.169.254) is always strictly blocked.
SSRF_ALLOW_INTERNAL=true
