# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@db:5432/internalapi?schema=public"

# Security & Secrets Encryption (AES-256-GCM)
INTERNALAPI_SECRET_KEY="internalapi-super-secure-master-encryption-key-32chars"
JWT_SECRET="internalapi-jwt-token-secret-change-in-production"

# SSRF Protection
# When true, testing internal private subnet APIs (10.x, 192.168.x, 172.x) is allowed.
# Cloud metadata (169.254.169.254) is always strictly blocked regardless.
SSRF_ALLOW_INTERNAL=true

