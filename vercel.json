{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "packages/client",
      "framework": "vite"
    },
    "server": {
      "root": "packages/server",
      "framework": "fastify",
      "bindings": [
        {
          "type": "service",
          "service": "database-api",
          "format": "url",
          "env": "DATABASE_API_URL"
        }
      ]
    },
    "database-api": {
      "root": "packages/database-api",
      "framework": "fastify"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
