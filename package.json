{
  "name": "internalapi-root",
  "version": "1.0.0",
  "private": true,
  "description": "InternalAPI - Enterprise Self-Hosted API Client",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=@internalapi/server\" \"npm run dev --workspace=@internalapi/client\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "postman",
    "api-client",
    "internal-tools",
    "self-hosted"
  ],
  "author": "InternalAPI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
